LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_GROUP_IDS=Cxxxx
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_SERVICE_ACCOUNT_JSON=          # path to json file, or the raw json
SHEET_ID_MAP=Cxxxx:1AbC...            # groupId:spreadsheetId, comma separated
HEAD_NURSE_LINE_IDS=Uaaaa,Ubbbb       # only persistent LINE IDs in the system
